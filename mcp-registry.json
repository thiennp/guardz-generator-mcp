{
  "name": "guardz-generator-mcp",
  "description": "Preview, write, and audit guardz runtime type guards from TypeScript types",
  "version": "2.0.0",
  "author": "Thien Nguyen",
  "repository": {
    "type": "git",
    "url": "https://github.com/thiennp/guardz-generator-mcp.git"
  },
  "homepage": "https://github.com/thiennp/guardz-generator-mcp#readme",
  "license": "MIT",
  "keywords": ["mcp", "typescript", "type-guard", "guardz", "runtime-validation"],
  "installation": {
    "npm": "npm install -g guardz-generator-mcp",
    "npx": "npx -y guardz-generator-mcp"
  },
  "configuration": {
    "command": "guardz-generator-mcp"
  },
  "features": {
    "tools": [
      "preview_type_guard",
      "apply_type_guards",
      "audit_type_guards",
      "explain_type"
    ],
    "prompts": ["add-runtime-guard"],
    "transports": ["stdio"],
    "authentication": "none"
  }
}
